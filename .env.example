# The API the app calls. Defaults to https://api.entreprise.de9de9.dz/api/v1,
# which allows the dev server (http://localhost:5173) and the production front
# (https://entreprise.de9de9.dz) in its CORS policy — calls go to it directly.
# VITE_API_URL=https://api.entreprise.de9de9.dz/api/v1

# Google / Apple sign-in. Public client ids: the API verifies the token the
# provider hands the browser. Leave them unset and those buttons stay disabled.
# VITE_GOOGLE_CLIENT_ID=
# VITE_APPLE_CLIENT_ID=
# Defaults to the app's own origin.
# VITE_APPLE_REDIRECT_URI=
